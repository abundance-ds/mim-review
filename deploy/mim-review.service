[Unit]
Description=AI peer review MCP
After=network.target

[Service]
Type=simple
User=peer-review
Group=peer-review
WorkingDirectory=/opt/mim-review
EnvironmentFile=/etc/mim-review.env
ExecStart=/usr/bin/node /opt/mim-review/src/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
# Writable access metadata only. Never store manuscript content here.
StateDirectory=mim-review
StateDirectoryMode=0700
Environment=ACCESS_DB=/var/lib/mim-review/access.sqlite
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitCORE=0
MemorySwapMax=0
MemoryMax=1G
TasksMax=128
UMask=0077

[Install]
WantedBy=multi-user.target

# Local defaults. Use the public HTTPS origin when deploying behind Caddy.
BASE_URL=http://localhost:3334
HOST=127.0.0.1
PORT=3334

# Open by default. Set true for invitation-only MCP and processing endpoints.
PROTECT_APP=false

# Required when protected. Generate with: openssl rand -hex 32
# This token opens /admin. Never use it as a user access key.
ADMIN_TOKEN=

# Optional metadata-only SQLite path. Default: .state/access.sqlite
# The supplied systemd unit sets /var/lib/mim-review/access.sqlite.
# ACCESS_DB=.state/access.sqlite

# Enable only behind a trusted reverse proxy on the same machine.
TRUST_PROXY=0

# Optional scholarly metadata settings. Neither is an AI-provider key.
CROSSREF_EMAIL=
OPENALEX_API_KEY=

# Optional exact additional Origin values for trusted MCP clients, comma-separated.
ALLOWED_ORIGINS=
